<?xml version="1.0" encoding="utf-8"?>
<config>
    <fieldset name="phase1" label="Email configuration">
        <!-- field 
            name="note1" 
            type="note" 
            label="The master API key will be overwitten in the final step of the Wizard"
        / -->
        <field
            name="email_limit"
            type="list"
            filter="integer"
            default="10000"
            label="Max emails per month"
            description="Maximum number of emails that can be sent per billing cycle by the Group's SMTP2GO sub-account">
            <option value="2000">2,000</option>
            <option value="5000">5,000</option>
            <option value="10000">10,000</option>
            <option value="20000">20,000</option>
            <option value="30000">30,000</option>
            <option value="40000">40,000</option>
            <option value="50000">50,000</option>
        </field>
    </fieldset>

    <fieldset
        name="permissions"
        label="JCONFIG_PERMISSIONS_LABEL"
        description="JCONFIG_PERMISSIONS_DESC" >
        <field
            name="rules"
            type="rules"
            label="JCONFIG_PERMISSIONS_LABEL"
            validate="rules"
            filter="rules"
            component="com_ra_tools"
            section="component"
        />
    </fieldset>
</config>
