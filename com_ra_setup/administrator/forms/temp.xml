<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Ramblers\Component\Ra_setup\Administrator\Field">
  <fieldset>
    <field name="id" type="text" readonly="true" class="readonly" default="0" description="JGLOBAL_FIELD_ID_DESC"/>
    <field name="state" default="1" type="list" label="JSTATUS" description="JFIELD_PUBLISHED_DESC" class="inputbox" size="1">
      <option value="1">JPUBLISHED</option>
      <option value="0">JUNPUBLISHED</option>
      <option value="2">JARCHIVED</option>
      <option value="-2">JTRASHED</option>
    </field>
    <field name="ordering"/>
    <field name="checked_out" type="hidden" filter="unset"/>
    <field name="checked_out_time" type="hidden" filter="unset"/>
    <field name="created_by" type="createdby" default="0" label="JGLOBAL_FIELD_CREATED_BY_LABEL" description="JGLOBAL_FIELD_CREATED_BY_DESC" hidden="true" hint="COM_RA_SETUP_FORM_LBL_TEMP_CREATED_BY"/>
    <field name="modified_by" type="modifiedby" default="0" label="JGLOBAL_FIELD_MODIFIED_BY_LABEL" description="JGLOBAL_FIELD_MODIFIED_BY_DESC" hidden="true" hint="COM_RA_SETUP_FORM_LBL_TEMP_MODIFIED_BY"/>
    <field name="version" filter="safehtml" type="text" required="true" label="COM_RA_SETUP_FORM_LBL_TEMP_VERSION" description="COM_RA_SETUP_FORM_DESC_TEMP_VERSION" hint="COM_RA_SETUP_FORM_LBL_TEMP_VERSION"/>
    <field name="component_name" maxlength="30" filter="safehtml" type="text" label="COM_RA_SETUP_FORM_LBL_TEMP_COMPONENT_NAME" description="COM_RA_SETUP_FORM_DESC_TEMP_COMPONENT_NAME" hint="COM_RA_SETUP_FORM_LBL_TEMP_COMPONENT_NAME"/>
    <field name="component_type_id" sql_select="id,name" sql_from="#__ra_component_types" sql_order="name" key_field="id" value_field="name" type="sql" layout="joomla.form.field.list-fancy-select" label="COM_RA_SETUP_FORM_LBL_TEMP_COMPONENT_TYPE_ID" description="COM_RA_SETUP_FORM_DESC_TEMP_COMPONENT_TYPE_ID" hint="COM_RA_SETUP_FORM_LBL_TEMP_COMPONENT_TYPE_ID"/>
    <field name="replace" type="radio" label="COM_RA_SETUP_FORM_LBL_TEMP_REPLACE" description="COM_RA_SETUP_FORM_DESC_TEMP_REPLACE" hint="COM_RA_SETUP_FORM_LBL_TEMP_REPLACE">
      <option value="1">COM_RA_SETUP_TEMPS_REPLACE_OPTION_1</option>
      <option value="0">COM_RA_SETUP_TEMPS_REPLACE_OPTION_0</option>
    </field>
    <field name="build_date" class="inputbox" format="%Y-%m-%d" timeformat="24" filter="user_utc" translateformat="false" showtime="false" singleheader="false" todaybutton="false" weeknumbers="false" filltable="false" type="calendar" label="COM_RA_SETUP_FORM_LBL_TEMP_BUILD_DATE" description="COM_RA_SETUP_FORM_DESC_TEMP_BUILD_DATE" hint="COM_RA_SETUP_FORM_LBL_TEMP_BUILD_DATE"/>
    <field name="version_note" type="text" label="JGLOBAL_FIELD_VERSION_NOTE_LABEL" description="JGLOBAL_FIELD_VERSION_NOTE_DESC" class="inputbox" size="45" labelclass="control-label"/>
  </fieldset>
</form>
