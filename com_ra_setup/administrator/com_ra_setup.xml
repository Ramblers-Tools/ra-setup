<?xml version="1.0" encoding="utf-8"?>
<extension type="component" version="4.0" method="upgrade">
	<name>RA Setup</name>
	<author>Ramblers</author>
	<creationDate>7 September 2026</creationDate>
	<copyright>Copyright (C) 2026 Ramblers. All rights reserved.</copyright>
	<license>GNU General Public License version 2 or later</license>
	<version>0.2.7</version>
	<description>Installation Wizard to set up a new website</description>
	<element>com_ra_setup</element>
	<scriptfile>script.php</scriptfile>
	<namespace path="src">Ramblers\Component\Ra_setup</namespace>
	<files folder="site">
		<folder>forms</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>
	<administration>
		<menu>RA Setup</menu>
		<files folder="administrator">
			<filename>access.xml</filename>
			<filename>config.xml</filename>
			<folder>languages</folder>
			<folder>services</folder>
			<folder>src</folder>
			<folder>tmpl</folder>
		</files>
		<languages folder="administrator">
			<language tag="en-GB">languages/en-GB/com_ra_setup.ini</language>
			<language tag="en-GB">languages/en-GB/com_ra_setup.sys.ini</language>
		</languages>
	</administration>
</extension>
