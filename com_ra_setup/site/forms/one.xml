<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Ramblers\Component\Ra_tools\Administrator\Field">
    <fieldset>
    <field
        name="area_group"
        type="radio"
        label="Is the site for an Area or a Group?"
        description=""
        classs="btn-group btn-group-yesno"
        default="G"
        >
            <option value="G">Group</option>
            <option value="A">Area</option>
    </field>
    <field
        name="group_code"
        type="test"
        label="Code"
        description="Four character Group code"
        showon="area_group:G"
    />       
    <field
        name="area_code"
        type="test"
        label="Code"
        description="Two character Area code"
        showon="area_group:A"
    />   
   <field
        name="site_name"
        type="textfield"
        label="Site name"
        description="Name to be given to the Site"
        required="true"
        default=""
    />
    <field
        name="strapline"
        type="textfield"
        label="Strapline"
        description="Line of text below the Site name in the header"
        required="true"
        default=""
    />
    </fields>
  </fieldset>
</form>